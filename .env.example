# Banco de dados PostgreSQL
DATABASE_URL="postgresql://soja:soja@localhost:5432/custo_soja"

# ── Microsoft Entra ID ──
# Lidos em RUNTIME pelo servidor (via /api/config) e usados para validar o
# ID token nas rotas de API. A mesma imagem Docker funciona em qualquer tenant
# sem rebuild — basta trocar estas variáveis no ambiente.
AZURE_TENANT_ID=d2f590c5-6fba-44a1-a322-a2278cefaee1
AZURE_CLIENT_ID=a8110041-c4cd-48c5-a931-760544036b8e
# Sem AZURE_CLIENT_SECRET — usa PKCE (public client flow).
# No portal Azure: Authentication > Allow public client flows = Yes
